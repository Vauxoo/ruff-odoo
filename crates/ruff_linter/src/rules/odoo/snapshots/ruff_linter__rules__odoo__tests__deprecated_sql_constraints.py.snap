help: Replace with `models.Constraint` attributes
   |
18 |     # ODE9501: several entries, and one of them with no message at all.
   -     _sql_constraints = [
   -         ("check_amount", "CHECK (amount > 0)", "The amount must be positive."),
   -         ("account_uniq", "unique (account_id, date)"),
   -     ]
