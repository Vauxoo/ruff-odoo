ODE9501 [*] Model attribute `_sql_constraints` is no longer supported since Odoo 19.0, define `models.Constraint` attributes on the model instead
  --> deprecated_sql_constraints.py:37:5
   |
35 |     # ODE9501: a message too long to keep the call on one line once rewritten, so the fix
36 |     # expands it with one argument per line and a magic trailing comma.
37 |     _sql_constraints = [
   |     ^^^^^^^^^^^^^^^^
38 |         (
39 |             "product_location_uniq",
   |
help: Replace with `models.Constraint` attributes
   |
36 |     # expands it with one argument per line and a magic trailing comma.
   -     _sql_constraints = [
   -         (
   -             "product_location_uniq",
   -             "unique (product_id, location_id, lot_id, package_id, owner_id)",
   -             "A quant can only exist once per product, location, lot, package and owner.",
   -         ),
   -     ]
37 +     _product_location_uniq = models.Constraint(
38 +         "unique (product_id, location_id, lot_id, package_id, owner_id)",
39 +         "A quant can only exist once per product, location, lot, package and owner.",
40 +     )
41 |
