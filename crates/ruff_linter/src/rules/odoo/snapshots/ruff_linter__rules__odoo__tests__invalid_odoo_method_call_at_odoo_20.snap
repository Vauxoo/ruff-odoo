   |         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
14 |         self.env["sale.order"].read_group([], fields=["amount:sum"], groupby=["partner_id"])
15 |         # ODE9502: `_search` dropped `access_rights_uid` in 18.0.
   |

